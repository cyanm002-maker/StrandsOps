# ==============================================================================
# OpsRanger RAG Service Environment Configuration
# ==============================================================================

# Hugging Face API Token (Enter your token here for deployments or authenticated downloads)
HF_TOKEN=hf_your_actual_token_here

# (Optional) Alternative variable name recognized by Hugging Face / LangChain
# HUGGINGFACEHUB_API_TOKEN=hf_your_actual_token_here

# (Optional) Embedding model name - default is all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# (Optional) Force offline mode once the model is cached locally (set to 1 to disable external calls)
# HF_HUB_OFFLINE=1

# Server port configuration
PORT=8000
HOST=0.0.0.0
